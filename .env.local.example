# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never expose to the client. Used by the PDF generation route
# and the data-migration script to write to Storage/tables directly.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed when running scripts/migrate-from-sheets.ts.
# Share the Google Sheet as "Anyone with the link -> Viewer", then paste the
# id from its URL below (the part between /d/ and /edit).
GOOGLE_SHEET_ID=
